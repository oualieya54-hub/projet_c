<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="member_hub_window">
    <property name="title" translatable="yes">Member Dashboard</property>
    <property name="default_width">300</property>
    <property name="default_height">250</property>
    <property name="border_width">15</property>
    <property name="window_position">GTK_WIN_POS_CENTER</property>
    <signal name="destroy" handler="gtk_main_quit" swapped="no"/>
    <child>
      <object class="GtkVBox" id="vbox_member">
        <property name="visible">True</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkLabel" id="label_hello_member">
            <property name="visible">True</property>
            <property name="label" translatable="yes">Hello, Member!</property>
            <property name="xalign">0</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_member_request_coach">
            <property name="label" translatable="yes">Request Private Coach</property>
            <property name="visible">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_member_view_subscriptions">
            <property name="label" translatable="yes">View Subscriptions</property>
            <property name="visible">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_member_register_course">
            <property name="label" translatable="yes">Register for a Course</property>
            <property name="visible">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_inscrit_salle">
            <property name="label" translatable="yes">Register for Gym</property>
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="btn_logout">
            <property name="label" translatable="yes">Logout</property>
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="padding">10</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
